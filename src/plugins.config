# Undo History: multi-level undo for Fiji / ImageJ 1.x
Edit, "Undo History...", undohistory.Undo_History("window")
Edit, "Redo", undohistory.Undo_History("redo")
Plugins>Undo History, "Undo History Window", undohistory.Undo_History("window")
Plugins>Undo History, "Undo History Step Back", undohistory.Undo_History("back")
Plugins>Undo History, "Undo History Step Forward", undohistory.Undo_History("redo")
Plugins>Undo History, "Keep This State", undohistory.Undo_History("keep")
Plugins>Undo History, "Clear History of Image", undohistory.Undo_History("clear")
Plugins>Undo History, "Undo History Options...", undohistory.Undo_History("options")
Plugins>Undo History, "Start Undo History", undohistory.Undo_History("start")
